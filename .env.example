DATABASE_URL="postgresql://USER@localhost:5432/nmiet_event_hub?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# console logs and writes .dev-emails.log. Set to "resend" in production.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="NMIET Event Hub <events@nmiet.edu.in>"

# local writes to public/uploads. Set to "s3" for object storage.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Show demo accounts on the login screen. Set to false in production.
DEMO_MODE="true"

# Optional. When both are set, Google sign-in is enabled.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
